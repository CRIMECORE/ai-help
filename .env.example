# Скопируй в .env и заполни. На bot-host.ru эти же переменные задаются в панели
# (Environment Variables) — тогда .env не нужен и секреты не попадут в GitHub.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # токен от @BotFather (обязательно)

# --- LLM / Whisper (OpenAI или совместимый, напр. OpenRouter) ---
OPENAI_API_KEY=                # ключ (обязательно)
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# --- Google Таблица Hermes Inbox ---
GOOGLE_SHEET_ID=1lmA-VtNqa0bk-sqcnJ1_eGBL44M19iWz1Rbeu-ZV07I

# Сервисный аккаунт (JSON целиком в одну строку ИЛИ путь к файлу):
# Вариант А (bot-host): вставь ВЕСЬ JSON сервисного ключа в кавычках:
GOOGLE_CREDENTIALS_JSON=
# Вариант Б (локально): путь к файлу service_account.json:
# GOOGLE_CREDENTIALS_FILE=./service_account.json

# --- Прочее ---
NOTES_DIR=./notes
ALLOWED_USER_ID=               # твой Telegram ID (узнать у @userinfobot)
APPROVE_CHAT_ID=               # куда слать подтверждения (обычно = ALLOWED_USER_ID)
