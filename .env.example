# Скопируй этот файл в .env и заполни своими значениями.
# На bot-host.ru эти же переменные задаются в панели (Environment Variables) —
# тогда .env не нужен.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI-совместимого провайдера (обязательно)
# Можно использовать OpenAI, OpenRouter, или любой совместимый.
OPENAI_API_KEY=

# Базовый URL API (необязательно). Для OpenAI оставь пустым / https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Модель для ответов (необязательно)
CHAT_MODEL=gpt-4o-mini

# Модель для расшифровки голоса (необязательно)
WHISPER_MODEL=whisper-1

# Папка для заметок Obsidian (необязательно)
NOTES_DIR=./notes

# Твой Telegram ID (необязательно, но рекомендуется — защищает бота от чужих)
# Узнать можно у @userinfobot
ALLOWED_USER_ID=
